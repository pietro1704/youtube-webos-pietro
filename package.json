{
  "name": "youtube-webos",
  "version": "0.8.4",
  "description": "Ad-free YouTube app for webOS",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "webpack --mode=production",
    "build:modern": "webpack --mode=production --env modern",
    "build:perf": "webpack --mode=production --env perf",
    "build:perf:modern": "webpack --mode=production --env modern --env perf",
    "build:dev": "webpack --mode=development",
    "test": "npm run build && npm run test:features",
    "test:mse-speed": "node bench/mse-speed-test.mjs && node bench/speed-controller-test.mjs && node bench/speed-hardware-test.cjs dist/webOSUserScripts/userScript.js",
    "test:features": "node --test bench/ublock-test.mjs && node bench/webos-cli-package-test.cjs && node bench/playback-preferences-test.mjs && node bench/dearrow-test.mjs && npm run test:mse-speed && node bench/speed-test.cjs dist/webOSUserScripts/userScript.js && node bench/settings-speed-test.cjs dist/webOSUserScripts/userScript.js && node bench/settings-entry-test.cjs dist/webOSUserScripts/userScript.js && node bench/video-quality-test.cjs dist/webOSUserScripts/userScript.js && node bench/dependency-test.cjs dist/webOSUserScripts/userScript.js && node bench/dislike-timing-test.cjs dist/webOSUserScripts/userScript.js legacy && node bench/module-behaviour-test.cjs dist/webOSUserScripts/userScript.js",
    "build:dev:inspect": "npm run build:dev && npm run package && npm run deploy && npm run inspect",
    "package": "ares-package -n dist -o dist",
    "deploy": "node tools/deploy.js",
    "inspect": "ares-inspect youtube.leanback.v4",
    "launch": "ares-launch youtube.leanback.v4",
    "manifest": "node tools/gen-manifest.cjs youtube.leanback.v4.manifest.json",
    "version": "node tools/sync-version.cjs && git add assets/appinfo.json",
    "prepare": "husky",
    "lint": "eslint",
    "type-check": "tsc -b",
    "prettier-check": "prettier --ignore-path .prettierignore --check ."
  },
  "repository": "github:webosbrew/youtube-webos",
  "license": "GPL-3.0-only",
  "bugs": "https://github.com/NicholasBly/youtube-webos/issues",
  "homepage": "https://github.com/NicholasBly/youtube-webos#readme",
  "dependencies": {
    "@twemoji/api": "16.0.1",
    "tiny-sha256": "^1.0.2",
    "whatwg-fetch": "^3.6.20"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.28.0",
    "@babel/plugin-transform-typescript": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@eslint/js": "^9.30.1",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/babel__core": "^7.20.5",
    "@types/eslint": "^9.6.1",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/node": "^24.10.1",
    "@webos-tools/cli": "^3.2.6",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "cssnano": "^7.1.2",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-regexp": "^2.9.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.31",
    "postcss-load-config": "^6.0.1",
    "postcss-loader": "^8.1.1",
    "postcss-preset-env": "^10.5.0",
    "prettier": "^3.7.4",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "transform-async-modules-webpack-plugin": "^1.1.1",
    "typescript": "^5.8.3",
    "webpack": "^5.112.2",
    "webpack-cli": "^6.0.1"
  },
  "engines": {
    "node": ">=22"
  }
}
